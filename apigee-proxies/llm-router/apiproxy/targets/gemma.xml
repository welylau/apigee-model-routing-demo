<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<TargetEndpoint name="gemma">
    <Description>Cloud Run Gemma (Ollama)</Description>
    <PreFlow name="PreFlow">
        <Request>
            <Step>
                <Name>AM-SetTargetModel</Name>
            </Step>
            <Step>
                <Name>JS-AzureRequest</Name>
            </Step>
        </Request>
        <Response>
            <!-- Model failover: errors reach this flow (success.codes), retry once on a backup Gemini model. -->
            <Step>
                <Name>JS-FailoverCheck</Name>
            </Step>
            <Step>
                <Name>AM-FailoverRequest</Name>
                <Condition>llmr.failover_needed = "true"</Condition>
            </Step>
            <Step>
                <Name>SC-Failover</Name>
                <Condition>llmr.failover_needed = "true"</Condition>
            </Step>
            <Step>
                <Name>JS-FailoverApply</Name>
                <Condition>llmr.failover_needed = "true"</Condition>
            </Step>
            <Step>
                <Name>AM-FaultResponse</Name>
                <Condition>llmr.primary_failed = "true" and llmr.failover != "true"</Condition>
            </Step>
            <Step>
                <Name>JS-AzureResponse</Name>
                <Condition>llmr.primary_failed != "true"</Condition>
            </Step>
        </Response>
    </PreFlow>
    <HTTPTargetConnection>
        <Properties>
            <Property name="success.codes">1xx,2xx,3xx,4xx,5xx</Property>
        </Properties>
        <Authentication>
            <GoogleIDToken>
                <Audience>https://gemma2-api-YOUR_PROJECT_NUMBER.asia-southeast1.run.app</Audience>
            </GoogleIDToken>
        </Authentication>
        <URL>https://gemma2-api-YOUR_PROJECT_NUMBER.asia-southeast1.run.app/v1/chat/completions</URL>
    </HTTPTargetConnection>
</TargetEndpoint>
