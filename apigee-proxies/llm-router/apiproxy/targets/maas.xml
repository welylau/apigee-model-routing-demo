<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<TargetEndpoint name="maas">
    <Description>Vertex AI MaaS: open models served by Google on the OpenAI-compatible chat/completions endpoint (e.g. GLM 5.2). The model is chosen at runtime by the request "model" field (routing.properties maas_models allow-list).</Description>
    <PreFlow name="PreFlow">
        <Request>
            <Step>
                <Name>AM-SetTargetModel</Name>
            </Step>
            <Step>
                <Name>JS-MaasRequest</Name>
            </Step>
        </Request>
        <Response>
            <!-- Model failover: errors reach this flow (success.codes), retry once on a backup Gemini model. -->
            <Step>
                <Name>JS-FailoverCheck</Name>
            </Step>
            <Step>
                <Name>AM-FailoverRequest</Name>
                <Condition>llmr.failover_needed = "true"</Condition>
            </Step>
            <Step>
                <Name>SC-Failover</Name>
                <Condition>llmr.failover_needed = "true"</Condition>
            </Step>
            <Step>
                <Name>JS-FailoverApply</Name>
                <Condition>llmr.failover_needed = "true"</Condition>
            </Step>
            <Step>
                <Name>AM-FaultResponse</Name>
                <Condition>llmr.primary_failed = "true" and llmr.failover != "true"</Condition>
            </Step>
            <Step>
                <Name>JS-MaasResponse</Name>
                <Condition>llmr.primary_failed != "true"</Condition>
            </Step>
        </Response>
    </PreFlow>
    <HTTPTargetConnection>
        <Properties>
            <Property name="success.codes">1xx,2xx,3xx,4xx,5xx</Property>
            <!-- Reasoning models can think for a while before they answer. -->
            <Property name="io.timeout.millis">180000</Property>
        </Properties>
        <Authentication>
            <GoogleAccessToken>
                <Scopes>
                    <Scope>https://www.googleapis.com/auth/cloud-platform</Scope>
                </Scopes>
            </GoogleAccessToken>
        </Authentication>
        <!-- Placeholder; overwritten by AM-SetTargetModel -->
        <URL>https://aiplatform.googleapis.com/v1</URL>
    </HTTPTargetConnection>
</TargetEndpoint>
