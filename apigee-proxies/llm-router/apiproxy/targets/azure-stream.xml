<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<TargetEndpoint name="azure-stream">
    <Description>Azure AI Foundry Target</Description>
    <PreFlow name="PreFlow">
        <Request>
            <Step>
                <Name>KVM-GetAzureKey</Name>
            </Step>
            <Step>
                <Name>AM-SetAzureAuth</Name>
            </Step>
            <Step>
                <Name>JS-AzureRequest</Name>
            </Step>
        </Request>
        <Response>
            <!-- Model failover: errors reach this flow (success.codes), retry once on a backup Gemini model. -->
            <Step>
                <Name>JS-FailoverCheck</Name>
            </Step>
            <Step>
                <Name>AM-FailoverRequest</Name>
                <Condition>llmr.failover_needed = "true"</Condition>
            </Step>
            <Step>
                <Name>SC-Failover</Name>
                <Condition>llmr.failover_needed = "true"</Condition>
            </Step>
            <Step>
                <Name>JS-FailoverApply</Name>
                <Condition>llmr.failover_needed = "true"</Condition>
            </Step>
            <Step>
                <Name>AM-FaultResponse</Name>
                <Condition>llmr.primary_failed = "true" and llmr.failover != "true"</Condition>
            </Step>
            <Step>
                <Name>JS-AzureResponse</Name>
                <Condition>llmr.primary_failed != "true"</Condition>
            </Step>
        </Response>
    </PreFlow>
    <HTTPTargetConnection>
        <Properties>
            <Property name="success.codes">1xx,2xx,3xx,4xx,5xx</Property>
        </Properties>
        <URL>https://YOUR_AZURE_RESOURCE.services.ai.azure.com/openai/v1/chat/completions</URL>
    </HTTPTargetConnection>
</TargetEndpoint>
