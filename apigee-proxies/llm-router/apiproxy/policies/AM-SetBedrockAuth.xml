<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<AssignMessage continueOnError="false" enabled="true" name="AM-SetBedrockAuth">
    <DisplayName>AM-SetBedrockAuth</DisplayName>
    <!-- Strip gateway-only headers (incl. the Apigee API key) before calling Amazon Bedrock. -->
    <Remove>
        <Headers>
            <Header name="x-api-key"/>
            <Header name="x-router-strategy"/>
            <Header name="x-simulate-outage"/>
            <Header name="x-preferred-model"/>
            <Header name="x-preferred-model-simple"/>
            <Header name="x-preferred-model-standard"/>
            <Header name="x-preferred-model-complex"/>
            <Header name="x-preferred-model-coding"/>
            <Header name="Authorization"/>
        </Headers>
    </Remove>
    <AssignVariable>
        <Name>target.url</Name>
        <Ref>llmr.target_url</Ref>
    </AssignVariable>
    <Add>
        <Headers>
            <!-- A Bedrock API key is a bearer token, so no SigV4 signing is needed. -->
            <Header name="Authorization">Bearer {private.bedrock_api_key}</Header>
        </Headers>
    </Add>
    <IgnoreUnresolvedVariables>false</IgnoreUnresolvedVariables>
    <AssignTo createNew="false" transport="http" type="request"/>
</AssignMessage>
