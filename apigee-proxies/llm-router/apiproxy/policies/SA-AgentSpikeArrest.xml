<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<SpikeArrest continueOnError="false" enabled="true" name="SA-AgentSpikeArrest">
    <DisplayName>SA-AgentSpikeArrest</DisplayName>
    <!-- Per app. The rate comes from the API product attribute "spike_rate" (e.g. 120pm for coding agents); 30pm otherwise. -->
    <Identifier ref="client_id"/>
    <Rate ref="verifyapikey.VA-AgentKey.apiproduct.spike_rate">30pm</Rate>
    <UseEffectiveCount>true</UseEffectiveCount>
</SpikeArrest>
