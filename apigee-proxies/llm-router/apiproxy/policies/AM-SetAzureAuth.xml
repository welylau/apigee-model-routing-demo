<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<AssignMessage continueOnError="false" enabled="true" name="AM-SetAzureAuth">
    <DisplayName>AM-SetAzureAuth</DisplayName>
    <!-- Strip gateway-only headers (incl. the Apigee API key) before calling Azure. -->
    <Remove>
        <Headers>
            <Header name="x-api-key"/>
            <Header name="x-router-strategy"/>
            <Header name="x-simulate-outage"/>
            <Header name="x-preferred-model"/>
            <Header name="x-preferred-model-simple"/>
            <Header name="x-preferred-model-standard"/>
            <Header name="x-preferred-model-complex"/>
            <Header name="x-preferred-model-coding"/>
        </Headers>
    </Remove>
    <AssignVariable>
        <Name>target.url</Name>
        <Ref>llmr.target_url</Ref>
    </AssignVariable>
    <Add>
        <Headers>
            <Header name="api-key">{private.azure_api_key}</Header>
        </Headers>
    </Add>
    <IgnoreUnresolvedVariables>false</IgnoreUnresolvedVariables>
    <AssignTo createNew="false" transport="http" type="request"/>
</AssignMessage>
