<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<AssignMessage continueOnError="false" enabled="true" name="AM-SetTargetModel">
    <DisplayName>AM-SetTargetModel</DisplayName>
    <!-- Point the target at the model chosen by JS-DecideRoute and strip gateway-only headers. -->
    <Remove>
        <Headers>
            <Header name="x-api-key"/>
            <Header name="x-router-strategy"/>
            <Header name="x-simulate-outage"/>
            <Header name="x-preferred-model"/>
            <Header name="x-preferred-model-simple"/>
            <Header name="x-preferred-model-standard"/>
            <Header name="x-preferred-model-complex"/>
            <Header name="x-preferred-model-coding"/>
        </Headers>
        <QueryParams/>
    </Remove>
    <AssignVariable>
        <Name>target.copy.pathsuffix</Name>
        <Value>false</Value>
    </AssignVariable>
    <AssignVariable>
        <Name>target.copy.queryparams</Name>
        <Value>false</Value>
    </AssignVariable>
    <AssignVariable>
        <Name>target.url</Name>
        <Ref>llmr.target_url</Ref>
    </AssignVariable>
    <IgnoreUnresolvedVariables>false</IgnoreUnresolvedVariables>
    <AssignTo createNew="false" transport="http" type="request"/>
</AssignMessage>
