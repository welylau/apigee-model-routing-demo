<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<RaiseFault continueOnError="false" enabled="true" name="RF-PayloadTooLarge">
    <DisplayName>RF-PayloadTooLarge</DisplayName>
    <FaultResponse>
        <Set>
            <StatusCode>413</StatusCode>
            <ReasonPhrase>Payload Too Large</ReasonPhrase>
            <Payload contentType="application/json">{"error":{"code":413,"message":"Prompt exceeds the maximum allowed size."}}</Payload>
        </Set>
    </FaultResponse>
    <IgnoreUnresolvedVariables>true</IgnoreUnresolvedVariables>
</RaiseFault>
